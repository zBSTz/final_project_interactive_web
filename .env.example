# =====================================================
# IoT Smart Room Monitor - Environment Configuration
# =====================================================
# Copy this file to .env.local and modify with your settings
# NEVER commit .env.local to version control
# =====================================================

# =====================================================
# 🌐 MQTT Broker Configuration
# =====================================================
# The WebSocket URL where your MQTT broker is accessible
# The app connects via WebSocket (ws:// or wss://) for browser compatibility

# Local Development
# NEXT_PUBLIC_MQTT_BROKER_URL=ws://localhost:9001

# Network MQTT Broker (via IP address)
# NEXT_PUBLIC_MQTT_BROKER_URL=ws://192.168.1.100:9001

# Cloud/Remote MQTT Broker (with domain)
# NEXT_PUBLIC_MQTT_BROKER_URL=ws://mqtt.yourdomain.com:9001

# Production with SSL/TLS
# NEXT_PUBLIC_MQTT_BROKER_URL=wss://mqtt.yourdomain.com:8883

NEXT_PUBLIC_MQTT_BROKER_URL=ws://192.168.43.188:9001

# =====================================================
# 📡 MQTT Topic Configuration
# =====================================================
# Topics for sensor data and device control
# These should match your IoT device configuration

# Topic: Where the temperature sensor PUBLISHES data
# The web app SUBSCRIBES to this topic to receive readings
# Default: sensor/temperature
# Example format: device/room1/temperature
NEXT_PUBLIC_MQTT_TEMPERATURE_TOPIC=sensor/temperature

# Topic: Where the web app PUBLISHES AC control commands
# IoT devices SUBSCRIBE to this topic to receive commands
# Expected messages: ON, OFF, or AUTO
# Default: led/control
# Example format: device/room1/ac/control
NEXT_PUBLIC_MQTT_LED_CONTROL_TOPIC=led/control

# =====================================================
# 🎨 Application Configuration
# =====================================================

# Application display name (shown in header)
NEXT_PUBLIC_APP_NAME=Smart Room Monitor

# =====================================================
# 🌡️ Temperature Configuration
# =====================================================
# Define the acceptable temperature range for simulation and validation

# Minimum simulated temperature (°C)
# Used for validation and simulation fallback
NEXT_PUBLIC_TEMP_MIN=25

# Maximum simulated temperature (°C)
# Used for validation and simulation fallback
NEXT_PUBLIC_TEMP_MAX=40

# =====================================================
# 🔧 Node.js Environment
# =====================================================
# Controls application behavior (logging, optimization, etc.)

# Values: development | production | test
# development: Verbose logging, hot reload enabled
# production: Optimized builds, minimal logging
NODE_ENV=development

# =====================================================
# 📋 Optional: Advanced MQTT Configuration
# =====================================================
# Uncomment and modify if using authentication

# MQTT Broker username (if required)
# NEXT_PUBLIC_MQTT_USERNAME=your_username

# MQTT Broker password (if required)
# NEXT_PUBLIC_MQTT_PASSWORD=your_password

# MQTT Client ID prefix (for identifying connections)
# NEXT_PUBLIC_MQTT_CLIENT_ID=roomMonitor

# =====================================================
# 📌 IMPORTANT NOTES
# =====================================================
# 1. Variables prefixed with NEXT_PUBLIC_ are exposed to client-side code
#    NEVER store sensitive data (passwords, API keys) in these variables
#
# 2. If MQTT broker is unreachable, the app automatically falls back to
#    SIMULATED temperature data for demonstration purposes
#
# 3. For Docker deployments, ensure:
#    - Environment variables are passed correctly
#    - MQTT broker is reachable from container network
#    - Firewall rules allow WebSocket traffic (port 9001)
#
# 4. WebSocket Protocol:
#    - ws://  = Unencrypted WebSocket (development)
#    - wss:// = Encrypted WebSocket (production recommended)
#
# 5. Common Broker Ports:
#    - 1883  = MQTT TCP
#    - 9001  = MQTT WebSocket
#    - 8883  = MQTT over TLS/SSL
#    - 8884  = MQTT over TLS/SSL WebSocket
